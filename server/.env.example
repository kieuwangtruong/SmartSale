# Neon: dùng chuỗi kết nối "Pooled connection" (có -pooler) từ Neon Console.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# URL public của Static Site trên Render, không thêm dấu / ở cuối.
PUBLIC_WEB_URL=https://your-store.onrender.com
# Các domain được phép gọi API, phân cách bằng dấu phẩy.
CORS_ORIGINS=https://your-store.onrender.com,http://localhost:5173

# Bắt buộc: tối thiểu 32 ký tự ngẫu nhiên, chỉ lưu tại Render Environment.
JWT_SECRET=replace-with-a-long-random-secret

# Tài khoản quản trị được tạo một lần khi chạy migrate (không có mặc định).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_FULL_NAME=Quản trị viên

# Google Gemini AI (Miễn phí từ aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (server-only, nếu dùng gói nạp phí OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# PayOS: lấy từ kênh thanh toán của chính tài khoản PayOS của bạn.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

PORT=10000
